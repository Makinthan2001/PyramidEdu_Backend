generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "library"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                    String              @id @default(uuid())
  fullName              String              @map("full_name")
  email                 String              @unique
  password              String
  phone                 String?
  role                  Role                @default(STUDENT)
  status                UserStatus          @default(PENDING)
  profileImage          String?             @map("profile_image")
  isActive              Boolean             @default(true) @map("is_active")
  forcePwdChange        Boolean             @default(false) @map("force_pwd_change")
  lastLogin             DateTime?           @map("last_login")
  emailVerifiedAt       DateTime?           @map("email_verified_at")
  deletedAt             DateTime?           @map("deleted_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  admin                 Admin?
  sentAnnouncements     Announcement[]      @relation("SentAnnouncements")
  auditLogs             AuditLog[]
  chatConversations     ChatConversation[]
  classSessions         ClassSession[]
  enrollmentChanges     EnrollmentHistory[] @relation("EnrollmentChangedBy")
  manager               Manager?
  receivedNotifications Notification[]      @relation("ReceivedNotifications")
  sentNotifications     Notification[]      @relation("SentNotifications")
  refreshTokens         RefreshToken[]
  student               Student?
  teacher               Teacher?
  sessions              UserSession[]
  receivedAnnouncements Announcement[]      @relation("AnnouncementRecipients")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Admin {
  id            String         @id @default(uuid())
  userId        String         @unique @map("user_id")
  accessLevel   Int            @default(1) @map("access_level")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcements Announcement[]

  @@map("admins")
}

model Manager {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  salary      Decimal?  @db.Decimal(12, 2)
  address     String?
  gender      Gender?
  nic         String?   @unique
  joiningDate DateTime? @map("joining_date")
  lastLogin   DateTime? @map("last_login")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("managers")
}

model Teacher {
  id                 String              @id @default(uuid())
  userId             String              @unique @map("user_id")
  subjectId          String?             @map("subject_id")
  salary             Decimal?            @db.Decimal(12, 2)
  address            String?
  gender             Gender?
  nic                String?             @unique
  phone              String?
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  attendances        Attendance[]
  classSessions      ClassSession[]
  enrollments        Enrollment[]
  exams              Exam[]
  manualExams        ManualExam[]
  quizzes            Quiz[]
  results            Result[]
  studyMaterials     StudyMaterial[]
  subjectAllocations SubjectAllocation[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

model Student {
  id                     String                    @id @default(uuid())
  userId                 String                    @unique @map("user_id")
  parentId               String?                   @map("parent_id")
  streamId               String?                   @map("stream_id")
  indexNumber            String?                   @unique @map("index_number")
  dateOfBirth            DateTime?                 @map("date_of_birth")
  address                String?
  phone                  String?
  gender                 Gender?
  batch                  String?
  nic                    String?                   @unique
  qrCode                 String?                   @unique @map("qr_code")
  rewardPoints           Int                       @default(0) @map("reward_points")
  dailyStreak            Int                       @default(0) @map("daily_streak")
  longestStreak          Int                       @default(0) @map("longest_streak")
  lastPracticeDate       DateTime?                 @map("last_practice_date")
  attendancePercentage   Decimal                   @default(0) @map("attendance_percentage") @db.Decimal(5, 2)
  performanceStatus      PerformanceLevel?         @map("performance_status")
  trendStatus            TrendStatus?              @map("trend_status")
  enrolledAt             DateTime?                 @map("enrolled_at")
  deletedAt              DateTime?                 @map("deleted_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  approvalStatus         ApprovalStatus            @default(PENDING) @map("approval_status")
  paymentStatus          RegistrationPaymentStatus @default(PENDING) @map("payment_status")
  freeCardType           FreeCardType              @default(NONE) @map("free_card_type")
  totalFeeAmount         Decimal                   @default(0) @map("total_fee_amount") @db.Decimal(12, 2)
  school                 String?
  feeEffectiveDate       DateTime?                 @map("fee_effective_date")
  lastFeeUpdateDate      DateTime?                 @map("last_fee_update_date")
  batchId                String?                   @map("batch_id")
  attendances            Attendance[]
  enrollmentHistories    EnrollmentHistory[]
  enrollments            Enrollment[]
  examSubmissions        ExamSubmission[]
  fees                   Fee[]
  manualExamMarks        ManualExamMark[]
  parentReports          ParentReport[]
  payments               Payment[]
  performancePredictions PerformancePrediction[]
  dailyQuizResults       DailyQuizResult[]
  rewardHistories        RewardHistory[]
  qrCodes                QRCode[]
  results                Result[]
  deviceTokens           StudentDeviceToken[]
  batchRecord            Batch?                    @relation(fields: [batchId], references: [id])
  parent                 Parent?                   @relation(fields: [parentId], references: [id])
  stream                 Stream?                   @relation(fields: [streamId], references: [id])
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([batch])
  @@index([batchId])
  @@index([approvalStatus])
  @@map("students")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  loginAt   DateTime  @default(now()) @map("login_at")
  logoutAt  DateTime? @map("logout_at")
  isActive  Boolean   @default(true) @map("is_active")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model Stream {
  id          String    @id @default(uuid())
  streamName  String    @map("stream_name")
  paymentDate DateTime? @map("payment_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  students    Student[]
  batches     Batch[]   @relation("BatchToStream")
  subjects    Subject[] @relation("StreamToSubject")

  @@map("streams")
}

model Subject {
  id                 String              @id @default(uuid())
  subjectName        String              @map("subject_name")
  subjectCode        String              @unique @map("subject_code")
  feeAmount          Decimal             @map("fee_amount") @db.Decimal(12, 2)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  classSessions      ClassSession[]
  enrollments        Enrollment[]
  exams              Exam[]
  manualExams        ManualExam[]
  quizzes            Quiz[]
  studyMaterials     StudyMaterial[]
  subjectAllocations SubjectAllocation[]
  announcements      Announcement[]      @relation("AnnouncementSubjects")
  streams            Stream[]            @relation("StreamToSubject")

  @@map("subjects")
}

model SubjectAllocation {
  id         String                  @id @default(uuid())
  teacherId  String                  @map("teacher_id")
  subjectId  String                  @map("subject_id")
  status     SubjectAllocationStatus @default(ACTIVE)
  assignedAt DateTime                @default(now()) @map("assigned_at")
  createdAt  DateTime                @default(now()) @map("created_at")
  subject    Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batches    Batch[]                 @relation("BatchToSubjectAllocation")

  @@unique([teacherId, subjectId])
  @@map("subject_allocations")
}

model Enrollment {
  id               String           @id @default(uuid())
  studentId        String           @map("student_id")
  subjectId        String           @map("subject_id")
  enrolledDate     DateTime         @default(now()) @map("enrolled_date")
  endDate          DateTime?        @map("end_date")
  enrollmentStatus EnrollmentStatus @default(ACTIVE) @map("enrollment_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  teacherId        String?          @map("teacher_id")
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id])
  teacher          Teacher?         @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([subjectId])
  @@map("enrollments")
}

model EnrollmentHistory {
  id                 String   @id @default(uuid())
  studentId          String   @map("student_id")
  previousStream     String?  @map("previous_stream")
  previousSubjects   Json     @map("previous_subjects")
  previousMonthlyFee Decimal  @map("previous_monthly_fee") @db.Decimal(12, 2)
  newStream          String?  @map("new_stream")
  newSubjects        Json     @map("new_subjects")
  newMonthlyFee      Decimal  @map("new_monthly_fee") @db.Decimal(12, 2)
  effectiveDate      DateTime @map("effective_date")
  changedById        String   @map("changed_by_id")
  changedAt          DateTime @default(now()) @map("changed_at")
  changedBy          User     @relation("EnrollmentChangedBy", fields: [changedById], references: [id])
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("enrollment_histories")
}

model StudyMaterial {
  id          String               @id @default(uuid())
  teacherId   String               @map("teacher_id")
  subjectId   String               @map("subject_id")
  title       String
  text        String?
  uploadedAt  DateTime             @default(now()) @map("uploaded_at")
  deletedAt   DateTime?            @map("deleted_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  batch       String?
  fileUrls    String[]             @map("file_urls")
  status      String               @default("Pending Review")
  batchId     String?              @map("batch_id")
  chunks      StudyMaterialChunk[]
  batchRecord Batch?               @relation(fields: [batchId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  teacher     Teacher              @relation(fields: [teacherId], references: [id])

  @@index([subjectId])
  @@index([teacherId])
  @@index([batchId])
  @@map("study_materials")
}

model StudyMaterialChunk {
  id            String                 @id @default(uuid())
  materialId    String                 @map("material_id")
  chunkIndex    Int                    @map("chunk_index")
  chunkText     String                 @map("chunk_text")
  embedding     Unsupported("vector")?
  createdAt     DateTime               @default(now()) @map("created_at")
  studyMaterial StudyMaterial          @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("study_material_chunks")
}

model Quiz {
  id               String            @id @default(uuid())
  subjectId        String?           @map("subject_id")
  teacherId        String?           @map("teacher_id")
  quizTitle        String            @map("quiz_title")
  totalMarks       Int               @default(100) @map("total_marks")
  isPublished      Boolean           @default(false) @map("is_published")
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  subject          Subject?          @relation(fields: [subjectId], references: [id])
  teacher          Teacher?          @relation(fields: [teacherId], references: [id])
  results          Result[]
  questions        Question[]        @relation("QuizQuestions")
  dailyQuizResults DailyQuizResult[]
  rewardHistories  RewardHistory[]

  @@index([subjectId])
  @@map("quizzes")
}

model Exam {
  id                    String           @id @default(uuid())
  subjectId             String           @map("subject_id")
  teacherId             String           @map("teacher_id")
  examTitle             String           @map("exam_title")
  examType              ExamType         @default(MCQ) @map("exam_type")
  examDate              DateTime         @map("exam_date")
  totalMarks            Int              @default(100) @map("total_marks")
  isPublished           Boolean          @default(false) @map("is_published")
  startTime             DateTime?        @map("start_time")
  duration              Int?
  deletedAt             DateTime?        @map("deleted_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  batch                 String?
  batchId               String?          @map("batch_id")
  pdfUrl                String?          @map("pdf_url")
  lateExamAvailableTime Int?             @map("late_exam_available_time")
  examSchedules         ExamSchedule[]
  submissions           ExamSubmission[]
  batchRecord           Batch?           @relation(fields: [batchId], references: [id])
  subject               Subject          @relation(fields: [subjectId], references: [id])
  teacher               Teacher          @relation(fields: [teacherId], references: [id])
  questions             Question[]
  results               Result[]

  @@index([subjectId])
  @@index([examDate])
  @@index([batchId])
  @@map("exams")
}

model ExamSchedule {
  id          String   @id @default(uuid())
  examId      String   @map("exam_id")
  room        String?
  invigilator String?
  createdAt   DateTime @default(now()) @map("created_at")
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_schedules")
}

model Question {
  id              String          @id @default(uuid())
  examId          String          @map("exam_id")
  questionText    String?         @map("question_text")
  questionType    QuestionType    @map("question_type")
  marks           Int             @default(1)
  options         Json?
  correctAnswer   String?         @map("correct_answer")
  order           Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  explanation     String?
  imageUrl        String?         @map("image_url")
  difficultyLevel DifficultyLevel @default(MEDIUM) @map("difficulty_level")
  answers          ExamAnswer[]
  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  quizzes          Quiz[]            @relation("QuizQuestions")
  dailyQuizAnswers DailyQuizAnswer[]

  @@map("questions")
}

model ExamSubmission {
  id                String           @id @default(uuid())
  examId            String           @map("exam_id")
  studentId         String           @map("student_id")
  submittedAt       DateTime         @default(now()) @map("submitted_at")
  totalScore        Decimal?         @map("total_score") @db.Decimal(6, 2)
  status            String           @default("GRADED")
  submissionStatus  String           @default("SUBMITTED") @map("submission_status")
  answerPdfPublicId String?          @map("answer_pdf_public_id")
  answerPdfUrl      String?          @map("answer_pdf_url")
  attendanceStatus  AttendanceStatus @default(PRESENT) @map("attendance_status")
  answers           ExamAnswer[]
  exam              Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@map("exam_submissions")
}

model ExamAnswer {
  id           String         @id @default(uuid())
  submissionId String         @map("submission_id")
  questionId   String         @map("question_id")
  answer       String
  isCorrect    Boolean?       @map("is_correct")
  marksAwarded Decimal?       @map("marks_awarded") @db.Decimal(6, 2)
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission   ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("exam_answers")
}

model Result {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  subjectId  String   @map("subject_id")
  examId     String?  @map("exam_id")
  quizId     String?  @map("quiz_id")
  teacherId  String?  @map("teacher_id")
  marks      Decimal  @db.Decimal(6, 2)
  grade      String?
  feedback   String?
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  exam       Exam?    @relation(fields: [examId], references: [id])
  quiz       Quiz?    @relation(fields: [quizId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([subjectId])
  @@map("results")
}

model QRCode {
  id            String       @id @default(uuid())
  studentId     String       @map("student_id")
  qrToken       String       @unique @map("qr_token")
  isActive      Boolean      @default(true) @map("is_active")
  generatedDate DateTime     @default(now()) @map("generated_date")
  createdAt     DateTime     @default(now()) @map("created_at")
  attendances   Attendance[]
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("qr_codes")
}

model ClassSession {
  id                  String             @id @default(uuid())
  subjectId           String             @map("subject_id")
  teacherId           String             @map("teacher_id")
  batchId             String?            @map("batch_id")
  sessionDate         DateTime           @map("session_date")
  sessionTime         String             @map("session_time")
  status              ClassSessionStatus @default(CREATED)
  attendanceStartTime DateTime?          @map("attendance_start_time")
  attendanceEndTime   DateTime?          @map("attendance_end_time")
  createdById         String             @map("created_by_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  attendances         Attendance[]
  batch               Batch?             @relation(fields: [batchId], references: [id])
  createdBy           User               @relation(fields: [createdById], references: [id])
  subject             Subject            @relation(fields: [subjectId], references: [id])
  teacher             Teacher            @relation(fields: [teacherId], references: [id])

  @@unique([subjectId, teacherId, sessionDate, sessionTime, batchId])
  @@map("class_sessions")
}

model Attendance {
  id               String           @id @default(uuid())
  studentId        String           @map("student_id")
  subjectId        String           @map("subject_id")
  qrCodeId         String?          @map("qr_code_id")
  attendanceDate   DateTime         @map("attendance_date")
  attendanceStatus AttendanceStatus @default(ABSENT) @map("attendance_status")
  attendanceMethod AttendanceMethod @default(MANUAL) @map("attendance_method")
  scannedTime      DateTime?        @map("scanned_time")
  isPresent        Boolean          @default(false) @map("is_present")
  markedAt         DateTime?        @map("marked_at")
  remarks          String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  teacherId        String?          @map("teacher_id")
  classSessionId   String?          @map("class_session_id")
  classSession     ClassSession?    @relation(fields: [classSessionId], references: [id])
  qrCode           QRCode?          @relation(fields: [qrCodeId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher          Teacher?         @relation(fields: [teacherId], references: [id])

  @@unique([studentId, classSessionId])
  @@index([studentId])
  @@index([subjectId])
  @@index([attendanceDate])
  @@map("attendances")
}

model Fee {
  id        String    @id @default(uuid())
  studentId String    @map("student_id")
  total     Decimal   @db.Decimal(12, 2)
  paid      Decimal   @default(0) @db.Decimal(12, 2)
  status    FeeStatus @default(UNPAID)
  monthYear DateTime  @map("month_year")
  dueDate   DateTime? @map("due_date")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@unique([studentId, monthYear])
  @@index([studentId])
  @@index([status])
  @@map("fees")
}

model Payment {
  id            String        @id @default(uuid())
  studentId     String        @map("student_id")
  feeId         String?       @map("fee_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod String        @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  invoiceNumber String?       @unique @map("invoice_number")
  paymentDate   DateTime      @map("payment_date")
  verifiedBy    String?       @map("verified_by")
  verifiedAt    DateTime?     @map("verified_at")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  fee           Fee?          @relation(fields: [feeId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([paymentStatus])
  @@map("payments")
}

model Parent {
  id            String         @id @default(uuid())
  parentName    String         @map("parent_name")
  relation      String?
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  occupation    String?
  parentReports ParentReport[]
  students      Student[]

  @@map("parents")
}

model ParentReport {
  id                String    @id @default(uuid())
  studentId         String    @map("student_id")
  parentId          String    @map("parent_id")
  attendanceSummary String?   @map("attendance_summary")
  performanceScore  Decimal?  @map("performance_score") @db.Decimal(5, 2)
  trendAnalysis     String?   @map("trend_analysis")
  aiRecommendation  String?   @map("ai_recommendation")
  isActive          Boolean   @default(true) @map("is_active")
  paymentDate       DateTime? @map("payment_date")
  generatedAt       DateTime  @default(now()) @map("generated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  isSent            Boolean   @default(false) @map("is_sent")
  parent            Parent    @relation(fields: [parentId], references: [id])
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("parent_reports")
}

model PerformancePrediction {
  id                    String           @id @default(uuid())
  studentId             String           @map("student_id")
  attendanceScore       Decimal          @map("attendance_score") @db.Decimal(5, 2)
  mcqScore              Decimal          @map("mcq_score") @db.Decimal(5, 2)
  essayScore            Decimal          @map("essay_score") @db.Decimal(5, 2)
  manualExamScore       Decimal          @map("manual_exam_score") @db.Decimal(5, 2)
  finalScore            Decimal          @map("final_score") @db.Decimal(5, 2)
  performanceLevel      PerformanceLevel @map("performance_level")
  trendStatus           TrendStatus      @map("trend_status")
  recommendations       String[]
  weightsUsed           Json             @map("weights_used")
  missedExamCount       Int              @default(0) @map("missed_exam_count")
  absentManualExamCount Int              @default(0) @map("absent_manual_exam_count")
  generatedAt           DateTime         @default(now()) @map("generated_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  student               Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([performanceLevel])
  @@map("performance_predictions")
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  title     String?
  isActive  Boolean       @default(true) @map("is_active")
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  role           String
  content        String
  tokensUsed     Int?             @map("tokens_used")
  responseTimeMs Int?             @map("response_time_ms")
  createdAt      DateTime         @default(now()) @map("created_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

model Notification {
  id               String           @id @default(uuid())
  senderId         String?          @map("sender_id")
  receiverId       String           @map("receiver_id")
  title            String
  message          String
  notificationType NotificationType @map("notification_type")
  isRead           Boolean          @default(false) @map("is_read")
  readAt           DateTime?        @map("read_at")
  deletedAt        DateTime?        @map("deleted_at")
  sentAt           DateTime         @default(now()) @map("sent_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  referenceId      String?          @map("reference_id")
  referenceType    String?          @map("reference_type")
  type             String           @default("GENERAL")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  receiver         User             @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)
  sender           User?            @relation("SentNotifications", fields: [senderId], references: [id])

  @@index([receiverId])
  @@index([isRead])
  @@map("notifications")
}

model Announcement {
  id            String             @id @default(uuid())
  adminId       String?            @map("admin_id")
  title         String
  content       String
  target        AnnouncementTarget @default(ALL)
  publishDate   DateTime           @map("publish_date")
  expiryDate    DateTime?          @map("expiry_date")
  isActive      Boolean            @default(true) @map("is_active")
  deletedAt     DateTime?          @map("deleted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  batchId       String?            @map("batch_id")
  attachmentUrl String?            @map("attachment_url")
  priority      String             @default("MEDIUM")
  senderId      String?            @map("sender_id")
  status        String             @default("DRAFT")
  admin         Admin?             @relation(fields: [adminId], references: [id])
  batchRecord   Batch?             @relation("BatchDirectAnnouncements", fields: [batchId], references: [id])
  sender        User?              @relation("SentAnnouncements", fields: [senderId], references: [id], onDelete: Cascade)
  batches       Batch[]            @relation("AnnouncementBatches")
  recipients    User[]             @relation("AnnouncementRecipients")
  subjects      Subject[]          @relation("AnnouncementSubjects")

  @@index([target])
  @@index([publishDate])
  @@index([status])
  @@index([batchId])
  @@map("announcements")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  action      AuditAction
  module      String
  description String?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

model SupportStaff {
  id         String    @id @default(uuid())
  staffCode  String    @unique @map("staff_code")
  staffName  String    @map("staff_name")
  position   String?
  department String?
  salary     Decimal?  @db.Decimal(12, 2)
  hirDate    DateTime? @map("hire_date")
  address    String?
  phone      String?
  nic        String?   @unique
  roleType   String?   @map("role_type")
  gender     Gender?
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("support_staff")
}

model Batch {
  id                  String              @id @default(uuid())
  batchName           String              @unique @map("batch_name")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  announcementsDirect Announcement[]      @relation("BatchDirectAnnouncements")
  classSessions       ClassSession[]
  exams               Exam[]
  manualExams         ManualExam[]
  students            Student[]
  materials           StudyMaterial[]
  announcements       Announcement[]      @relation("AnnouncementBatches")
  streams             Stream[]            @relation("BatchToStream")
  subjectAllocations  SubjectAllocation[] @relation("BatchToSubjectAllocation")

  @@map("batches")
}

model StudentDeviceToken {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  fcmToken  String   @unique @map("fcm_token")
  platform  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_device_tokens")
}

model NotificationLog {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  eventType String   @map("event_type")
  eventId   String   @map("event_id")
  sentAt    DateTime @default(now()) @map("sent_at")

  @@unique([studentId, eventType, eventId])
  @@map("notification_logs")
}

model ManualExam {
  id         String           @id @default(uuid())
  examTitle  String           @map("exam_title")
  subjectId  String           @map("subject_id")
  teacherId  String           @map("teacher_id")
  batchId    String           @map("batch_id")
  totalMarks Int              @map("total_marks")
  examDate   DateTime         @map("exam_date")
  duration   Int?             @map("duration")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  marks      ManualExamMark[]
  batch      Batch            @relation(fields: [batchId], references: [id])
  subject    Subject          @relation(fields: [subjectId], references: [id])
  teacher    Teacher          @relation(fields: [teacherId], references: [id])

  @@index([subjectId])
  @@index([teacherId])
  @@index([batchId])
  @@map("manual_exams")
}

model ManualExamMark {
  id            String     @id @default(uuid())
  manualExamId  String     @map("manual_exam_id")
  studentId     String     @map("student_id")
  marksObtained Decimal?   @map("marks_obtained") @db.Decimal(6, 2)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  isAbsent      Boolean    @default(false) @map("is_absent")
  manualExam    ManualExam @relation(fields: [manualExamId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([manualExamId, studentId])
  @@index([manualExamId])
  @@index([studentId])
  @@map("manual_exam_marks")
}

