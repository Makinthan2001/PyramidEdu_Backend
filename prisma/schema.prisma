// ============================================================
// schema.prisma
// PyramidEdu — Smart Institute Management & Student Performance Prediction System
// CST 394-2 | Group CST06 | Uva Wellassa University of Sri Lanka | 2026
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  TEACHER
  STUDENT
  SUPPORT_STAFF
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PerformanceCategory {
  EXCELLENT
  GOOD
  AVERAGE
  AT_RISK
}

enum TrendCategory {
  IMPROVING
  STABLE
  DECLINING
}

enum ExamType {
  EXAM
  QUIZ
  ASSIGNMENT
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  EXAM
  MID
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ============================================================
// MODELS
// ============================================================

// ------------------------------------------------------------
// USER — base authentication model for all roles
// ------------------------------------------------------------
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  forcePasswordChange Boolean @default(false) @map("force_password_change")
  isActive     Boolean  @default(true)  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  // Relations
  student       Student?
  teacher       Teacher?
  manager       Manager?
  supportStaff  SupportStaff?
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@index([email], name: "idx_users_email")
  @@index([role],  name: "idx_users_role")
  @@map("users")
}

// ------------------------------------------------------------
// REFRESH TOKEN — stores hashed refresh tokens for each session
// ------------------------------------------------------------
model RefreshToken {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  tokenFamily String   @map("token_family")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_user")
  @@index([tokenFamily], name: "idx_refresh_family")
  @@map("refresh_tokens")
}

// ------------------------------------------------------------
// PARENT
// ------------------------------------------------------------
model Parent {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  phone String?

  // Relations
  students Student[]

  @@map("parents")
}

// ------------------------------------------------------------
// STUDENT
// ------------------------------------------------------------
model Student {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  indexNumber String    @unique @map("index_number")
  phone       String?
  address     String?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  parentId    Int?      @map("parent_id")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user           User              @relation(fields: [userId],   references: [id], onDelete: Cascade)
  parent         Parent?           @relation(fields: [parentId], references: [id])
  enrollments    Enrollment[]
  attendance     Attendance[]
  feeInvoices    FeeInvoice[]
  studentExams   StudentExam[]
  marks          Marks[]
  performances   PerformanceRecord[]
  progressPoints ProgressPoint[]
  qrCode         QrCode?

  @@index([userId],   name: "idx_students_user_id")
  @@index([parentId], name: "idx_students_parent")
  @@map("students")
}

// ------------------------------------------------------------
// TEACHER
// ------------------------------------------------------------
model Teacher {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  nicNumber      String   @unique @map("nic_number")
  gender         Gender
  address        String
  phone          String
  specialization String?
  salary         Decimal? @db.Decimal(10, 2)

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  studyMaterials StudyMaterial[]

  @@map("teachers")
}

// ------------------------------------------------------------
// MANAGER
// ------------------------------------------------------------
model Manager {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  nicNumber  String   @unique @map("nic_number")
  gender     Gender
  address    String
  phone      String
  salary     Decimal? @db.Decimal(10, 2)
  fullName   String   @map("full_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_managers_user_id")
  @@map("managers")
}

// ------------------------------------------------------------
// SUPPORT STAFF
// ------------------------------------------------------------
model SupportStaff {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  nicNumber String?  @map("nic_number")
  gender    Gender?
  address   String?
  phone     String?
  fullName  String   @map("full_name")
  roleType  String   @map("role_type")
  salary    Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_support_staff_user_id")
  @@map("support_staff")
}

// ------------------------------------------------------------
// SUBJECT
// ------------------------------------------------------------
model Subject {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  teacherId    Int?     @map("teacher_id")
  feePerMonth  Decimal  @default(0) @map("fee_per_month") @db.Decimal(10, 2)
  description  String?
  isActive     Boolean  @default(true)  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  teacher      Teacher?            @relation(fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  attendance   Attendance[]
  exams        Exam[]
  marks        Marks[]
  performances PerformanceRecord[]
  materials    StudyMaterial[]
  feeInvoices  FeeInvoiceSubject[]
  subjectStreams SubjectStream[]

  @@map("subjects")
}

// ------------------------------------------------------------
// STREAM
// ------------------------------------------------------------
model Stream {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  subjectStreams SubjectStream[]

  @@map("streams")
}

// ------------------------------------------------------------
// SUBJECT_STREAM — subject ↔ stream many-to-many
// ------------------------------------------------------------
model SubjectStream {
  subjectId  Int @map("subject_id")
  streamId   Int @map("stream_id")

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  stream  Stream  @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([subjectId, streamId])
  @@index([streamId], name: "idx_subject_stream_stream")
  @@map("subject_streams")
}

// ------------------------------------------------------------
// ENROLLMENT — student ↔ subject many-to-many
// ------------------------------------------------------------
model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  subjectId  Int      @map("subject_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  isActive   Boolean  @default(true)  @map("is_active")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([studentId], name: "idx_enroll_student")
  @@index([subjectId], name: "idx_enroll_subject")
  @@map("enrollments")
}

// ------------------------------------------------------------
// QR CODE — one permanent QR token per student
// ------------------------------------------------------------
model QrCode {
  id        Int     @id @default(autoincrement())
  studentId Int     @unique @map("student_id")
  qrToken   String  @unique @map("qr_token")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}

// ------------------------------------------------------------
// ATTENDANCE
// ------------------------------------------------------------
model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int              @map("student_id")
  subjectId Int              @map("subject_id")
  date      DateTime         @default(now()) @db.Date
  isPresent Boolean          @default(false) @map("is_present")
  method    AttendanceMethod @default(QR)
  markedAt  DateTime         @default(now()) @map("marked_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, date])
  @@index([studentId], name: "idx_attend_student")
  @@index([date],      name: "idx_attend_date")
  @@map("attendance")
}

// ------------------------------------------------------------
// EXAM
// ------------------------------------------------------------
model Exam {
  id           Int      @id @default(autoincrement())
  subjectId    Int      @map("subject_id")
  title        String
  type         ExamType
  startTime    DateTime? @map("start_time")
  durationMins Int?      @map("duration_mins")
  totalMarks   Int       @default(100) @map("total_marks")
  isPublished  Boolean   @default(false) @map("is_published")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  subject      Subject       @relation(fields: [subjectId], references: [id])
  questions    Question[]
  studentExams StudentExam[]

  @@map("exams")
}

// ------------------------------------------------------------
// QUESTION — belongs to an exam
// ------------------------------------------------------------
model Question {
  id            Int     @id @default(autoincrement())
  examId        Int     @map("exam_id")
  questionText  String  @map("question_text")
  optionA       String? @map("option_a")
  optionB       String? @map("option_b")
  optionC       String? @map("option_c")
  optionD       String? @map("option_d")
  correctOption String? @map("correct_option") // 'A' | 'B' | 'C' | 'D'
  marks         Int     @default(1)

  // Relations
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("questions")
}

// ------------------------------------------------------------
// STUDENT_EXAM — exam submission & score
// ------------------------------------------------------------
model StudentExam {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  examId      Int      @map("exam_id")
  score       Int?
  submittedAt DateTime @default(now()) @map("submitted_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  exam    Exam    @relation(fields: [examId],    references: [id])

  @@unique([studentId, examId])
  @@map("student_exams")
}

// ------------------------------------------------------------
// MARKS — teacher-entered assessment marks
// ------------------------------------------------------------
model Marks {
  id             Int            @id @default(autoincrement())
  studentId      Int            @map("student_id")
  subjectId      Int            @map("subject_id")
  assessmentType AssessmentType @map("assessment_type")
  score          Decimal        @db.Decimal(6, 2)
  maxScore       Decimal        @default(100) @map("max_score") @db.Decimal(6, 2)
  recordedAt     DateTime       @default(now()) @map("recorded_at") @db.Date

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@map("marks")
}

// ------------------------------------------------------------
// FEE INVOICE — monthly invoice per student
// ------------------------------------------------------------
model FeeInvoice {
  id          Int       @id @default(autoincrement())
  studentId   Int       @map("student_id")
  totalAmount Decimal   @map("total_amount") @db.Decimal(10, 2)
  paidAmount  Decimal   @default(0) @map("paid_amount") @db.Decimal(10, 2)
  dueDate     DateTime? @map("due_date")  @db.Date
  paidDate    DateTime? @map("paid_date") @db.Date
  status      FeeStatus @default(PENDING)
  monthYear   String    @map("month_year") // e.g. '2026-05'
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  student  Student            @relation(fields: [studentId], references: [id])
  payments Payment[]
  subjects FeeInvoiceSubject[]

  @@index([studentId], name: "idx_invoice_student")
  @@index([status],    name: "idx_invoice_status")
  @@map("fee_invoices")
}

// ------------------------------------------------------------
// PAYMENT — individual payment against an invoice
// ------------------------------------------------------------
model Payment {
  id          Int           @id @default(autoincrement())
  invoiceId   Int           @map("invoice_id")
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(CASH)
  referenceNo String?       @map("reference_no")
  paidAt      DateTime      @default(now()) @map("paid_at")

  // Relations
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ------------------------------------------------------------
// FEE_INVOICE_SUBJECT — subject-wise fee breakdown per invoice
// ------------------------------------------------------------
model FeeInvoiceSubject {
  invoiceId Int     @map("invoice_id")
  subjectId Int     @map("subject_id")
  amount    Decimal @db.Decimal(10, 2)

  // Relations
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])
  subject Subject    @relation(fields: [subjectId], references: [id])

  @@id([invoiceId, subjectId])
  @@map("fee_invoice_subjects")
}

// ------------------------------------------------------------
// PERFORMANCE RECORD — AI-calculated weighted score per student/subject
// Weighted Score = (Attendance × 0.30) + (Quiz × 0.20) + (Assignment × 0.20) + (Exam × 0.30)
// Categories: EXCELLENT (80–100) | GOOD (60–79) | AVERAGE (40–59) | AT_RISK (<40)
// Trends: IMPROVING | STABLE (±5 pts) | DECLINING
// ------------------------------------------------------------
model PerformanceRecord {
  id               Int                  @id @default(autoincrement())
  studentId        Int                  @map("student_id")
  subjectId        Int?                 @map("subject_id")
  weightedScore    Decimal?             @map("weighted_score") @db.Decimal(5, 2)
  category         PerformanceCategory?
  trend            TrendCategory?
  aiRecommendation String?              @map("ai_recommendation")
  calculatedAt     DateTime             @default(now()) @map("calculated_at")

  // Relations
  student Student  @relation(fields: [studentId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@index([studentId], name: "idx_perf_student")
  @@index([category],  name: "idx_perf_category")
  @@map("performance_records")
}

// ------------------------------------------------------------
// PROGRESS POINT — gamification / reward points for students
// ------------------------------------------------------------
model ProgressPoint {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  points    Int      @default(0)
  reason    String?
  awardedAt DateTime @default(now()) @map("awarded_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id])

  @@map("progress_points")
}

// ------------------------------------------------------------
// NOTIFICATION — in-app notifications for all users
// ------------------------------------------------------------
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId],  name: "idx_notif_user")
  @@index([isRead],  name: "idx_notif_read")
  @@map("notifications")
}

// ------------------------------------------------------------
// STUDY MATERIAL — uploaded by teachers per subject
// ------------------------------------------------------------
model StudyMaterial {
  id         Int      @id @default(autoincrement())
  subjectId  Int      @map("subject_id")
  teacherId  Int      @map("teacher_id")
  title      String
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("study_materials")
}

// ============================================================
// AUDIT LOG — System-wide audit trail for compliance
// ============================================================
model AuditLog {
  id            Int      @id @default(autoincrement())
  action        String   // e.g., USER_CREATED, USER_UPDATED, USER_DELETED
  userId        Int?     @map("user_id")
  resourceType  String   @map("resource_type") // e.g., USER, SUBJECT, ENROLLMENT
  resourceId    Int      @map("resource_id")   // ID of the affected resource
  details       String?  // JSON string with change details
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId], name: "idx_audit_user")
  @@index([action], name: "idx_audit_action")
  @@index([resourceType, resourceId], name: "idx_audit_resource")
  @@index([createdAt], name: "idx_audit_timestamp")
  @@map("audit_logs")
}
