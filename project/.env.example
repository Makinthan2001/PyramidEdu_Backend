# ============================================================
# .env — PyramidEdu Backend
# Copy this to .env and fill in your values.
# NEVER commit the real .env to Git.
# ============================================================

# ─── Database (Neon PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://neondb_owner:<password>@<pooler-host>/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:<password>@<direct-host>/neondb?sslmode=require&channel_binding=require"

# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development                  # development | production
CORS_ORIGIN=http://localhost:3000     # frontend URL (comma-separate multiple)

# ─── JWT Secrets ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Each must be a different, long random string (min 32 characters).

JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_access
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_string_refresh
JWT_RESET_SECRET=replace_with_64_char_random_hex_string_reset

# ─── JWT Expiry ───────────────────────────────────────────────
# Access token: short-lived (15m recommended)
# Refresh token: long-lived (7d recommended)
# Reset token: very short (15m)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=15m
