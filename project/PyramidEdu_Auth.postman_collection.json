{
  "info": {
    "name": "PyramidEdu — Auth API",
    "description": "Complete authentication flow testing for PyramidEdu backend.\n\nTesting order:\n1. Register\n2. Login  (saves accessToken + refreshToken automatically)\n3. Get Me\n4. Refresh Token\n5. Change Password\n6. Forgot Password\n7. Reset Password\n8. Logout",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "resetToken",  "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@pyramidedu.lk\",\n  \"password\": \"Admin1234\",\n  \"role\": \"ADMIN\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "pm.test('Returns user', () => {",
            "  const json = pm.response.json();",
            "  pm.expect(json.success).to.be.true;",
            "  pm.expect(json.data.user).to.have.property('id');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@pyramidedu.lk\",\n  \"password\": \"Admin1234\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Returns access token', () => {",
            "  pm.expect(json.data.accessToken).to.be.a('string');",
            "});",
            "// Save accessToken for subsequent requests",
            "pm.collectionVariables.set('accessToken', json.data.accessToken);",
            "pm.test('Refresh token cookie set', () => {",
            "  pm.expect(pm.cookies.has('refreshToken')).to.be.true;",
            "});"
          ]
        }
      }]
    },
    {
      "name": "3. Get Me (protected)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Returns user profile', () => {",
            "  const json = pm.response.json();",
            "  pm.expect(json.data.user.email).to.equal('admin@pyramidedu.lk');",
            "  pm.expect(json.data.user).to.not.have.property('passwordHash');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "4. Refresh Token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/auth/refresh"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Returns new access token', () => {",
            "  pm.expect(json.data.accessToken).to.be.a('string');",
            "});",
            "pm.collectionVariables.set('accessToken', json.data.accessToken);"
          ]
        }
      }]
    },
    {
      "name": "5. Change Password (protected)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/auth/change-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"Admin1234\",\n  \"newPassword\": \"NewAdmin5678\",\n  \"confirmPassword\": \"NewAdmin5678\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Success message returned', () => {",
            "  pm.expect(pm.response.json().success).to.be.true;",
            "});"
          ]
        }
      }]
    },
    {
      "name": "6. Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/forgot-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@pyramidedu.lk\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "// In development, the token is returned directly",
            "if (json.data && json.data.devResetToken) {",
            "  pm.collectionVariables.set('resetToken', json.data.devResetToken);",
            "  console.log('Reset token saved:', json.data.devResetToken);",
            "}"
          ]
        }
      }]
    },
    {
      "name": "7. Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/reset-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"Admin1234\",\n  \"confirmPassword\": \"Admin1234\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Password reset success', () => {",
            "  pm.expect(pm.response.json().success).to.be.true;",
            "});"
          ]
        }
      }]
    },
    {
      "name": "8. Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('accessToken', '');"
          ]
        }
      }]
    },
    {
      "name": "9. Logout All Devices",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout?all=true",
          "query": [{ "key": "all", "value": "true" }]
        }
      }
    },
    {
      "name": "ERR: Register — validation fail",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"weak\",\n  \"role\": \"INVALID_ROLE\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 422', () => pm.response.to.have.status(422));",
            "pm.test('Errors array returned', () => {",
            "  pm.expect(pm.response.json().errors).to.be.an('array');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "ERR: Get Me — no token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status is 401', () => pm.response.to.have.status(401));"
          ]
        }
      }]
    }
  ]
}
